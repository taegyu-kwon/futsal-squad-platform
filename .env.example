# 로컬 실행용 예시입니다. .env.local로 복사해 값을 채우세요.
# 서버에서만 쓰는 값입니다. public/ 이나 dist/ 에 절대 넣지 마세요. .env* 파일은 .gitignore에 들어 있습니다.

# Neon(PostgreSQL) 접속 문자열. 본인 소유의 개발용 데이터베이스를 쓰세요.
# 예: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# 관리자 로그인 방식. 운영은 credentials(Auth.js)만 씁니다.
AUTH_PROVIDER=credentials

# 관리자 로그인 아이디
TEAM_ADMIN_EMAIL=admin

# 관리자 비밀번호의 scrypt 해시 (평문 비밀번호가 아님). README의 "로컬 실행" 3단계로 만듭니다.
# 형식: scrypt:<salt 64자 hex>:<digest 128자 hex>
OWNER_PASSWORD_HASH=

# 세션 서명용 비밀값. openssl rand -hex 32 로 만든 값을 넣으세요.
SESSION_SECRET=

# --- 온라인 대전 서버 (realtime/, 개발 브랜치) ---
# Cloudflare Worker 변수는 realtime/wrangler.jsonc 의 vars 에서 설정합니다.
# ROSTER_URL=http://127.0.0.1:4195/api/shared   # 선수 카드를 읽어올 공개 API (읽기 전용)
# EXTRA_ORIGINS=                                 # 쉼표로 구분한 추가 허용 Origin

# --- 이전 저장소 호환 코드 (운영 미사용) ---
# AUTH_PROVIDER 가 credentials 가 아닐 때만 lib/supabase-store.mjs 가 읽습니다.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_MEDIA_BUCKET=
